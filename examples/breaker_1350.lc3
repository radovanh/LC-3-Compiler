5:REM T = FRAME DELAY (WAIT T), SMALLER IS FASTER
10:CLEAR 0:CLS 0
20:√96=12,30,60,30,12
30:CURSOR 6:"LC-3 BREAKER":CURSOR 31:"FOR THE PC-1350"
35:CURSOR 78:"ENTER:PLAY  Q:QUIT"
40:DMS "0A=C=E=F="
50:#T WAIT 1:K=INKEY$:IF K=81 END
55:IF K¥13 GOTO #T
60:S=0:L=3:T=24
70:#R CLS 0:N=32:GOSUB #S
80:A=0
90:#F TRON A,8:A=A+1:IF A<150 GOTO #F
100:A=8
110:#G TRON 0,A:TRON 149,A:A=A+1:IF A<32 GOTO #G
120:I=0
130:#B X=I%16*9+3:Y=10:IF I>=16:Y=14
140:ON X,Y:GRAD 0707070707070707:I=I+1:IF I<32 GOTO #B
150:#N P=68:X=74:Y=28:U=1:V=255:IF RND 2:U=255
155:GOSUB #P
160:#M TRON X,Y:WAIT T:K=INKEY$:TROFF X,Y
170:IF K=15 IF P>=5 GOSUB #Q:P=P-4:GOSUB #P
180:IF K=14 IF P<134 GOSUB #Q:P=P+4:GOSUB #P
190:IF X<2:U=1
200:IF X>=148:U=255
210:IF Y<10:V=1
220:A=X+U:B=Y+V
230:IF B<18 IF PI A,B GOSUB #K
240:IF B=30 GOTO #C
250:X=A:Y=B:GOTO #M
260:#C IF A<P GOTO #L
270:IF A>=P+12 GOTO #L
280:V=255:U=1:IF A<P+6:U=255
285:IF K=15:U=255
286:IF K=14:U=1
290:SIN 99,3:GOTO #M
300:#L L=L-1:SIN 250,30:GOSUB #Q:GOSUB #S
310:IF L GOTO #N
320:CURSOR 58:"GAME OVER":CURSOR 78:"ENTER:PLAY  Q:QUIT":DMS "1P=C"
330:#Z WAIT 1:K=INKEY$:IF K=81 END
335:IF K¥13 GOTO #Z
340:RUN
350:#K C=A-3/9:D=C*9+3:E=10:IF B>=14:E=14
360:ON D,E:COS 248,7
370:V=0-V:S=S+1:N=N-1:SIN 200,6:GOSUB #S
380:IF N RETURN
390:ASN:CURSOR 56:"ROUND CLEAR":DMS "0A=C=E=F=":WAIT 250:IF T>=12:T=T-3
395:GOTO #R
400:#S CURSOR 0:"SCORE ":PRINT S:CURSOR 20:"     ":CURSOR 20:I=L
410:#V IF I=0 RETURN
420:CHR$ 0:I=I-1:GOTO #V
430:#P ON P,30:GRAD 030303030303030303030303:RETURN
440:#Q ON P,30:COS 252,11:RETURN
